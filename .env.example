# Postgres connection for the MemoryLoom MCP server (pgvector required).
# Placeholder values only — copy to .env.local and fill in your own.
DATABASE_URL=postgres://user:password@localhost:5432/memoryloom
# pg-boss queue name for embed jobs
MEMORY_QUEUE=memory-embed
# Web app (site + console): port and the ONE namespace it may read.
# Point it only at a database seeded with the synthetic demo corpus.
# WEB_PORT=4173
# WEB_NAMESPACE=memoryloom-demo
# Provider keys: the standard way to configure them is in the app —
# run it, open Settings, paste your own keys (they are stored in this
# file, on this machine only). Setting a key's environment variable
# instead also works and wins over Settings. Without a Meta key, the
# local provider covers model and router work offline. Without a Jev
# key there is no local fallback for decisions: the gate fails closed
# and proposals queue for human review instead. Baseten has no lane
# in this build, so its key unlocks nothing beyond a Settings
# connection test.
# META_API_KEY=
# BASETEN_API_KEY=
# Jev (TypeSafe) decision models:
# The older names META_MODEL_API_KEY and TYPESAFE_API_KEY are also accepted.
# JEV_API_KEY=
# Modal and Fireworks have no role in this build: there are no keys
# to set for them here, and setting one would change nothing.
